#!/usr/bin/env sh
# OpenSpec 门禁：push 前全量 strict 校验，失败阻断。
zero="0000000000000000000000000000000000000000"
while read -r local_ref local_sha pushed_ref pushed_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ -d openspec ]; then
    if ! npx --no-install openspec validate --all --strict; then
      echo "pre-push: openspec validate --all --strict 未通过；push 已阻断。"
      exit 1
    fi
  else
    echo "[WARN GOV-OPENSPEC] openspec/ 目录不存在，跳过 OpenSpec 校验。"
  fi
  break
done

# pytest 门禁：项目 venv 优先，其次系统 python3；pytest 缺失即阻断并提示安装（诚实优先）。
if [ -x .venv/bin/python ]; then PY=.venv/bin/python; else PY=python3; fi
if ! "$PY" -c "import pytest" >/dev/null 2>&1; then
  echo "pre-push: pytest 不可用（$PY）。请安装开发依赖：python3 -m venv .venv && .venv/bin/python -m pip install pytest"
  exit 1
fi
"$PY" -m pytest -q || exit 1
